# Based on esp-hosted-mcu v3.0.9 examples/ota/coprocessor_ota/cp (C6, SDIO, MCU host).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_EH_TRANSPORT_CP_SDIO=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_BT_ENABLED=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CACHE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=20
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
# Image must fit the C6's existing OTA slots when pushed from the P4; the
# partition table here only matters for a wired (TTL) flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# STREAM mode: IDF 5.5.4 lacks the >4092-byte SDIO send fix that SW_AGGR needs;
# ESP-NOW frames are tiny, so throughput is irrelevant here.
CONFIG_EH_TRANSPORT_CP_SDIO_MODE_STREAM=y

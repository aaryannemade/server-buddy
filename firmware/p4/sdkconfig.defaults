# Waveshare ESP32-P4-WIFI6-POE-ETH rev 2.0, as inventoried 2026-09-28:
# P4 silicon v1.3 (pre-v3: images built for v3.x will not boot), 32 MB flash,
# secure boot and flash encryption disabled.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-Hosted host over SDIO to the onboard C6. Pins are the P4 Function-EV
# defaults (slot 1: CLK18 CMD19 D0-D3 14-17), which Waveshare's examples use;
# C6 CHIP_PU is on GPIO54 (confirmed in the rev 2.0 schematic).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54

# sb_link: C6->P4 message handlers (STATUS, RX, SEND_DONE, RESULT + headroom).
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA_MAX_CUSTOM_MSG_HANDLERS=8

# TLS-only local API with WebSocket support.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_WS_SUPPORT=y
